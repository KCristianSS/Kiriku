# Variables de conexión a PostgreSQL / Supabase (completar en .env local, nunca subir .env al repositorio)
DATABASE_URL=
DATABASE_SSL=

# Credenciales locales opcionales para el contenedor PostgreSQL de docker-compose.yml
POSTGRES_DB=kiriku
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Supabase (opcional en desarrollo local con Docker; requerido en producción con Supabase Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Caché Redis y firma de tokens JWT
REDIS_URL=
JWT_SECRET=
TZ=America/La_Paz
